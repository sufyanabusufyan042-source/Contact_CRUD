<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Contact App - Home</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <h1>404 ERROR</h1>
        <% if(message){%>
            <h1><%= message %></h1>
            <%}else{%>
                <h1>Page not found.</h1>
                <%}%>
        <p>MongoDB + Express + EJS se bana hua simple CRUD application.</p>
        <div class="btn-group">
            <a href="/add-contact" class="btn btn-primary">Add Contact</a>
            <a href="/show-contact" class="btn btn-secondary">Show Contacts</a>
        </div>
    </div>
</body>
</html>