<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>All Contacts</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <h1>All Contacts</h1>
        <a href="/add-contact" class="btn btn-primary">+ Add New Contact</a>

        <table class="contact-table">
            <thead>
                <tr>
                    <th>SR number</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Address</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% var srno = Counter %>
                <% contacts.forEach(contact => { %>
                    <tr>
                         <td><%= srno++ %></td>
                        <td><%= contact.name %></td>
                        <td><%= contact.email %></td>
                        <td><%= contact.phone %></td>
                        <td><%= contact.address %></td>
                        <td class="action-buttons">
                            <a href="/update-contact/<%= contact._id %>" class="btn btn-edit">Edit</a>
                            <a href="/delete-contact/<%= contact._id %>" class="btn btn-delete"
                               onclick="return confirm('Are you sure you want to delete this contact?')">Delete</a>
                        </td>
                    </tr>
                <% }) %>
                <% if (contacts.length === 0) { %>
                    <tr>
                        <td colspan="5" style="text-align:center;">No contacts found</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
        <div class="pagination">
            <% if (result.hasPrevPage) { %>
                <a href="/show-contact?page=<%= result.prevPage %>" class="btn btn-secondary">Prev</a>
            <% } else { %>
                <span class="btn btn-secondary btn-disabled">Prev</span>
            <% } %>

            <% for (let i = 1; i <= result.totalPages; i++) { %>
                <a href="/show-contact?page=<%= i %>" class="page-num <%= i === result.page ? 'active' : '' %>"><%= i %></a>
            <% } %>

            <% if (result.hasNextPage) { %>
                <a href="/show-contact?page=<%= result.nextPage %>" class="btn btn-secondary">Next</a>
            <% } else { %>
                <span class="btn btn-secondary btn-disabled">Next</span>
            <% } %>
        </div>
        <a href="/" class="back-link">&larr; Back to Home</a>
    </div>
</body>
</html>
